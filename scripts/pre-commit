#!/usr/bin/env bash
# =================================================================
# security-writeups pre-commit hook — the last gate before GitHub.
#
# Blocks:
#   1. credential-looking strings in ANY staged text file
#   2. private keys / cloud API keys
#   3. filenames that advertise secrets
#   4. no-publish material (pwn.college and any dir marked .nopublish)
#
# Installed automatically by scripts/claude/session-guard.sh; the source
# of truth is scripts/pre-commit. Edit here, not in .git/hooks/.
#
# Design notes (learned from the audit that replaced the first version):
#   - EVERY text file is scanned, not just .md/.txt/.sh/.ps1. A password
#     pasted into a .py solver or an extensionless dump leaks just as hard.
#   - NUL-delimited filenames: a name with a space used to split into two
#     nonexistent paths and silently skip the scan.
#   - The whitelist is applied to the MATCHED TOKEN, not the whole line.
#     Line-level whitelisting meant one innocent word ("commit", "hash")
#     anywhere on the line disarmed the check for a real secret beside it.
# =================================================================

set -uo pipefail

RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'; NC='\033[0m'
VIOLATIONS=0
WARNINGS=0

echo "🔍 Pre-commit security scan..."

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

# ----------------------------------------------------------------
# 0. No-publish set: material that must never reach a public remote
# ----------------------------------------------------------------
# A directory is no-publish if it is listed below OR contains a .nopublish
# marker file. The marker makes the rule extensible without editing this hook.
NO_PUBLISH_DIRS=("Wargames/Pwn_College" "Wargames/GoN")

while IFS= read -r -d '' path; do
    [ -z "$path" ] && continue
    for nd in "${NO_PUBLISH_DIRS[@]}"; do
        case "$path" in
            "$nd"/*|"$nd")
                echo -e "${RED}❌ NO-PUBLISH PATH STAGED: $path${NC}"
                echo "   $nd is local-only: the platform's terms prohibit"
                echo "   public writeups. Unstage it: git rm --cached '$path'"
                VIOLATIONS=$((VIOLATIONS + 1))
                ;;
        esac
    done
    dir=$(dirname "$path")
    while [ "$dir" != "." ] && [ "$dir" != "/" ]; do
        if [ -f "$REPO_ROOT/$dir/.nopublish" ]; then
            echo -e "${RED}❌ NO-PUBLISH PATH STAGED: $path${NC}"
            echo "   $dir/.nopublish marks this tree as local-only."
            VIOLATIONS=$((VIOLATIONS + 1))
            break
        fi
        dir=$(dirname "$dir")
    done
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

# ----------------------------------------------------------------
# 1. Credential scan over every staged TEXT file
# ----------------------------------------------------------------
is_binary() {
    # git reports "-" for both numstat columns on binary blobs
    [ "$(git diff --cached --numstat -- "$1" | cut -f1)" = "-" ]
}

# A 30+ char alphanumeric run that is NOT one of the known-safe shapes.
# Safe shapes are judged on the TOKEN itself; masks are judged on the line.
token_is_safe() {
    local tok="$1"
    # hex digests: md5(32) sha1(40) sha224(56) sha256(64) sha384(96) sha512(128)
    if printf '%s' "$tok" | grep -qiE '^[0-9a-f]{32}$|^[0-9a-f]{40}$|^[0-9a-f]{56}$|^[0-9a-f]{64}$|^[0-9a-f]{96}$|^[0-9a-f]{128}$'; then
        return 0
    fi
    # OpenSSH public key body
    case "$tok" in AAAAB3Nza*|AAAAC3Nza*|AAAAE2VjZHNh*) return 0 ;; esac
    return 1
}

line_is_whitelisted() {
    printf '%s' "$1" | grep -qiE '(masked|redacted|example|placeholder|fingerprint|sha-?(1|224|256|384|512)|md5|checksum|digest|uuid|public[[:space:]]+key|key[[:space:]]+id|ssh-ed25519|ssh-rsa|<[^>]*>)'
}

while IFS= read -r -d '' file; do
    [ -z "$file" ] && continue
    is_binary "$file" && continue

    STAGED_CONTENT=$(git show ":$file" 2>/dev/null) || continue

    HITS=""
    while IFS= read -r numbered; do
        [ -z "$numbered" ] && continue
        lineno="${numbered%%:*}"
        linetext="${numbered#*:}"
        line_is_whitelisted "$linetext" && continue
        while IFS= read -r tok; do
            [ -z "$tok" ] && continue
            token_is_safe "$tok" && continue
            HITS="${HITS}  line ${lineno}: ${tok:0:12}…(${#tok} chars)"$'\n'
            break
        done < <(printf '%s' "$linetext" | grep -oE '[a-zA-Z0-9]{30,}')
    done < <(printf '%s' "$STAGED_CONTENT" | grep -nE '[a-zA-Z0-9]{30,}')

    if [ -n "$HITS" ]; then
        echo -e "${RED}❌ SUSPECT CREDENTIAL in $file:${NC}"
        printf '%s' "$HITS" | head -5
        VIOLATIONS=$((VIOLATIONS + 1))
    fi

    # Private key material
    # NOTE: optional group uses `( )?`, NOT `( |)` — BSD grep (macOS) rejects
    # empty alternation branches with "empty (sub)expression" and the check
    # would silently fail open.
    if printf '%s' "$STAGED_CONTENT" | grep -qE 'BEGIN (RSA |DSA |EC |OPENSSH |PGP )?PRIVATE KEY'; then
        echo -e "${RED}❌ PRIVATE KEY DETECTED in $file${NC}"
        VIOLATIONS=$((VIOLATIONS + 1))
    fi

    # Cloud / API keys
    if printf '%s' "$STAGED_CONTENT" | grep -qE '(AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|sk_live_[0-9a-zA-Z]{24,}|ghp_[0-9A-Za-z]{36}|github_pat_[0-9A-Za-z_]{22,}|xox[baprs]-[0-9A-Za-z-]{10,})'; then
        echo -e "${RED}❌ CLOUD/API KEY PATTERN in $file${NC}"
        VIOLATIONS=$((VIOLATIONS + 1))
    fi

    # Explicit "password: <plaintext>" (warning — too noisy to block)
    if printf '%s' "$STAGED_CONTENT" | grep -iE 'password[[:space:]]*[:=][[:space:]]*[a-zA-Z0-9]{8,}' \
        | grep -qivE '(masked|redacted|<|example|placeholder)'; then
        echo -e "${YELLOW}⚠️  Possible plaintext password in $file (review manually)${NC}"
        WARNINGS=$((WARNINGS + 1))
    fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

# ----------------------------------------------------------------
# 2. Filenames that advertise secrets
# ----------------------------------------------------------------
FORBIDDEN_NAMES=$(git diff --cached --name-only --diff-filter=ACMR \
    | grep -iE '(password|secret|credential|\.env$|_rsa$|\.pem$)' || true)
if [ -n "$FORBIDDEN_NAMES" ]; then
    echo -e "${RED}❌ FORBIDDEN FILENAME being committed:${NC}"
    echo "$FORBIDDEN_NAMES"
    VIOLATIONS=$((VIOLATIONS + 1))
fi

# ----------------------------------------------------------------
# 3. Report
# ----------------------------------------------------------------
echo ""
if [ "$VIOLATIONS" -gt 0 ]; then
    echo -e "${RED}========================================${NC}"
    echo -e "${RED}❌ COMMIT BLOCKED: $VIOLATIONS violation(s)${NC}"
    echo -e "${RED}========================================${NC}"
    echo ""
    echo "Options:"
    echo "  1. Mask the password: '<password masked>' or '[REDACTED]'"
    echo "  2. Unstage a no-publish path:  git rm --cached <file>"
    echo "  3. Confirmed false positive?  YOU run the bypass, not the agent."
    exit 1
fi

if [ "$WARNINGS" -gt 0 ]; then
    echo -e "${YELLOW}⚠️  $WARNINGS warning(s) — review before pushing${NC}"
fi

echo -e "${GREEN}✅ Security scan passed${NC}"
exit 0
