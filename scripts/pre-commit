#!/usr/bin/env bash
# =================================================================
# security-writeups pre-commit hook — the last gate before GitHub.
#
# Blocks:
#   1. credential-looking strings, private keys, cloud/API keys and
#      personal identifiers in ANY staged blob (scripts/claude/secret_scan.py)
#   2. filenames that advertise secrets
#   3. no-publish material: pwn.college / GoN trees, any dir marked
#      .nopublish, and ANY path .gitignore excludes (it can only be in the
#      index by force)
#
# Installed automatically by scripts/claude/session-guard.sh; the source
# of truth is scripts/pre-commit. Edit here, not in .git/hooks/.
#
# Design notes (each learned from an audit that broke the previous version):
#   - ONE walk over `git diff --cached --raw -z`: the blob SHA comes with
#     the path, so nothing is re-resolved through `git show ":path"` (a
#     file named `0:x.md` used to parse as a stage number and skip the scan).
#     -z means no C-quoting: `한글/.env` used to hide from the name check.
#     --diff-filter=ACMRT includes type changes (symlink → file).
#   - "binary" is judged by the scanner on CONTENT, never by numstat or
#     .gitattributes: a `*.md -diff` attribute line or a single NUL byte
#     used to switch the credential scan off for the whole file.
#   - the whitelist is judged on the TOKEN by the scanner, never on the
#     line: `password: X (for example)` and `X md5` used to pass.
#   - no-publish prefixes are compared case-insensitively (nocasematch):
#     `wargames/pwn_college/` staged via plumbing used to pass, and the
#     remote is case-sensitive so it would have been a distinct public path.
#   - `git check-ignore --no-index` on every staged path: an ignored path
#     in the index was force-staged, whatever its spelling or which list it
#     belongs to. The no-publish rule no longer depends on this hook's
#     hardcoded list agreeing with .gitignore.
#   - the content scanner is a separate process; if python3 or the scanner
#     is missing or it crashes, the commit is BLOCKED (fail closed). A gate
#     that silently degrades is not a gate.
#   - LC_ALL=C so bash pattern classes and git output are byte-stable.
# =================================================================

set -uo pipefail
export LC_ALL=C
shopt -s nocasematch

RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'; NC='\033[0m'
VIOLATIONS=0
WARNINGS=0

echo "🔍 Pre-commit security scan..."

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
SCANNER="$REPO_ROOT/scripts/claude/secret_scan.py"

# ----------------------------------------------------------------
# 0. No-publish set: material that must never reach a public remote
# ----------------------------------------------------------------
# A path is no-publish if it is under a dir listed below (case folded),
# under any dir holding a .nopublish marker (any file type), or excluded
# by .gitignore. The marker and .gitignore make the rule extensible
# without editing this hook.
NO_PUBLISH_DIRS=("Wargames/Pwn_College" "Wargames/GoN")

is_no_publish() {  # path -> 0 if the path must never be staged
    local p="$1" nd dir
    for nd in "${NO_PUBLISH_DIRS[@]}"; do
        case "$p" in "$nd"/*|"$nd") return 0 ;; esac
    done
    dir=$(dirname "$p")
    while [ "$dir" != "." ] && [ "$dir" != "/" ]; do
        [ -e "$REPO_ROOT/$dir/.nopublish" ] && return 0
        dir=$(dirname "$dir")
    done
    return 1
}

is_ignored() {  # path -> 0 if .gitignore excludes it (so it can only have been force-staged)
    # ./ prefix: a leading ':' would otherwise be read as pathspec magic
    git check-ignore -q --no-index -- "./$1" 2>/dev/null
}

RE_NAME='(password|secret|credential|\.env$|_rsa$|\.pem$)'
# A program named after secrets HANDLES them (scripts/claude/secret_scan.py);
# a data file named after secrets HOLDS them. Only the latter is a violation
# by name — a program's content is still scanned like every other blob.
RE_CODE='\.(py|sh|ps1)$'

# Records for the scanner: "<blob-sha> <path>\0" — a temp file because a
# bash variable cannot carry NUL and the walk must happen exactly once.
RECORDS=$(mktemp "${TMPDIR:-/tmp}/precommit.XXXXXX") || { echo "❌ mktemp failed"; exit 1; }
trap 'rm -f "$RECORDS"' EXIT
: > "$RECORDS"

# ----------------------------------------------------------------
# 1. One walk over the index
#    ":srcmode dstmode srcsha dstsha S[score]\0path\0"  (R/C: "\0old\0new\0")
# ----------------------------------------------------------------
while IFS= read -r -d '' meta && IFS= read -r -d '' path; do
    set -- $meta
    dstmode=$2; dstsha=$4; st=${5:0:1}
    if [ "$st" = "R" ] || [ "$st" = "C" ]; then IFS= read -r -d '' path || break; fi
    [ -z "$path" ] && continue

    # 1a. no-publish / never-commit material
    if is_no_publish "$path"; then
        echo -e "${RED}❌ NO-PUBLISH PATH STAGED: $path${NC}"
        echo "   local-only tree (platform ToS / .nopublish marker). Unstage: git rm --cached '$path'"
        VIOLATIONS=$((VIOLATIONS + 1))
    elif is_ignored "$path"; then
        echo -e "${RED}❌ IGNORED PATH FORCE-STAGED: $path${NC}"
        echo "   .gitignore excludes it ($(git check-ignore -v --no-index -- "./$path" 2>/dev/null | cut -f1)); it can only be in the index by force."
        VIOLATIONS=$((VIOLATIONS + 1))
    fi

    # 1b. filenames that advertise secrets (raw path, so quoting cannot hide it)
    if [[ "$path" =~ $RE_NAME ]] && ! [[ "$path" =~ $RE_CODE ]]; then
        echo -e "${RED}❌ FORBIDDEN FILENAME being committed: $path${NC}"
        VIOLATIONS=$((VIOLATIONS + 1))
    fi

    # 1c. collect the blob for the content scan (a gitlink has no blob)
    [ "$dstmode" = "160000" ] && continue
    [[ "$dstsha" =~ ^0+$ ]] && continue
    printf '%s %s\0' "$dstsha" "$path" >> "$RECORDS"
done < <(git diff --cached --raw -z --no-abbrev --diff-filter=ACMRT)

# ----------------------------------------------------------------
# 2. Content: every staged blob through the shared scanner, ONE process
# ----------------------------------------------------------------
if [ -s "$RECORDS" ]; then
    if command -v python3 >/dev/null 2>&1 && [ -f "$SCANNER" ]; then
        SCAN_OUT=$(python3 "$SCANNER" --git-blobs < "$RECORDS" 2>&1); rc=$?
        if [ "$rc" -eq 1 ]; then
            echo -e "${RED}❌ SUSPECT CREDENTIAL / KEY / IDENTIFIER in staged content:${NC}"
            printf '%s\n' "$SCAN_OUT" | sed 's/^/   /'
            nfiles=$(printf '%s\n' "$SCAN_OUT" | sed -E 's/: line [0-9]+ \[[^]]*\]: .*$//' | sort -u | grep -c .)
            VIOLATIONS=$((VIOLATIONS + ${nfiles:-1}))
        elif [ "$rc" -ne 0 ]; then
            echo -e "${RED}❌ secret scanner unavailable — commit blocked (fail closed)${NC}"
            printf '%s\n' "$SCAN_OUT" | sed 's/^/   /'
            VIOLATIONS=$((VIOLATIONS + 1))
        fi
    else
        echo -e "${RED}❌ secret scanner unavailable — commit blocked (fail closed)${NC}"
        echo "   needs python3 on PATH and $SCANNER"
        VIOLATIONS=$((VIOLATIONS + 1))
    fi
fi

# ----------------------------------------------------------------
# 3. Report
# ----------------------------------------------------------------
echo ""
if [ "$VIOLATIONS" -gt 0 ]; then
    echo -e "${RED}========================================${NC}"
    echo -e "${RED}❌ COMMIT BLOCKED: $VIOLATIONS violation(s)${NC}"
    echo -e "${RED}========================================${NC}"
    echo ""
    echo "Options:"
    echo "  1. Mask the password: '<password masked>' or '[REDACTED]'"
    echo "  2. Unstage a no-publish path:  git rm --cached <file>"
    echo "  3. Confirmed false positive?  YOU run the bypass, not the agent."
    exit 1
fi

if [ "$WARNINGS" -gt 0 ]; then
    echo -e "${YELLOW}⚠️  $WARNINGS warning(s) — review before pushing${NC}"
fi

echo -e "${GREEN}✅ Security scan passed${NC}"
exit 0
